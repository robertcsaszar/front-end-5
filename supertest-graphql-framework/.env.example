# API Configuration
API_BASE_URL=https://api.example.com
GRAPHQL_ENDPOINT=/graphql
API_TIMEOUT=30000

# Authentication Configuration
IDP_BASE_URL=https://idp.example.com
IDP_REALM=your-realm
IDP_CLIENT_ID=your-client-id
IDP_CLIENT_SECRET=your-client-secret
IDP_WELL_KNOWN_URL=https://idp.example.com/.well-known/openid-configuration

# PKCE Configuration
PKCE_CODE_VERIFIER_LENGTH=128
PKCE_CODE_CHALLENGE_METHOD=S256

# Test User Credentials
TEST_USER_EMAIL=testuser@example.com
TEST_USER_PASSWORD=TestPassword123!
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=AdminPassword123!

# Test Configuration
RUN_PARALLEL=true
MAX_WORKERS=4
TEST_TIMEOUT=60000
RETRY_ATTEMPTS=3
RETRY_DELAY=1000

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIR=./logs

# Reports
REPORT_DIR=./reports
GENERATE_HTML_REPORT=true
GENERATE_ALLURE_REPORT=true

# CSV Export
CSV_DOWNLOAD_TIMEOUT=30000
CSV_TEMP_DIR=./temp/csv

# Feature Flags (for conditional test execution)
TEST_USERS=true
TEST_GROUPS=true
TEST_TENANTS=true
TEST_ASSETS=true
TEST_DELEGATED_ADMIN=true
TEST_REPORTS=true
TEST_CSV_EXPORT=true
TEST_SEARCH=true
